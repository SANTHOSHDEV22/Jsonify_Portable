# --- Virtual environment ---
# Never commit this — it's several hundred MB of installed packages.
# Anyone cloning the repo recreates it with:
#   python -m venv venv
#   venv\Scripts\Activate.ps1
#   pip install -r requirements.txt
venv/
.venv/
env/

# --- Python bytecode / cache ---
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Visual Studio / Visual Studio Code project files ---
# These are local IDE settings (paths, window layout, breakpoints) —
# personal to your machine, not useful to anyone else on the repo.
.vs/
.vscode/
*.pyproj
*.pyproj.user
*.sln

# --- PyInstaller / build output, if you ever package this as an .exe ---
build/
dist/
*.spec

# --- OS-generated junk ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Editor swap/backup files ---
*.swp
*~

# --- The graph HTML this app writes at runtime ---
# (Notify writes notify_graph_view.html to your OS temp folder when you
# click "Open Graph in Browser" — that's outside the repo entirely, so
# it won't show up here regardless, but if you ever test by writing one
# into the project folder, ignore it too.)
notify_graph_view.html
test_graph.html