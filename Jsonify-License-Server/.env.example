# Azure SQL
DATABASE_SERVER=your-server.database.windows.net
DATABASE_NAME=jsonify_license
DATABASE_USERNAME=jsonify_admin
DATABASE_PASSWORD=replace_me
DATABASE_DRIVER=ODBC Driver 18 for SQL Server

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# RSA private signing key - backend only
JSONIFY_LICENSE_PRIVATE_KEY_PATH=secrets/license_private.pem

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_me
SMTP_PASSWORD=replace_me
SMTP_FROM=Jsonify <license@example.com>

# Public backend URL
PUBLIC_BACKEND_URL=https://license.example.com
